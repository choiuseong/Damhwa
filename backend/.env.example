# [변경] DATABASE_URL 기본값(내장 DB), OPENAI_API_KEY, OPENAI_SUMMARY_MODEL, CHAT_HIDE_THRESHOLD, CHAT_ADMIN_KEY, CHAT_UPLOAD_DIR 추가
PORT=3000

# ── DB 주소 (둘 중 하나만 쓰세요) ──
# 1) 내장 DB (npm run db:local, 설치 없음)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# 2) Docker PostgreSQL (docker 폴더에서 docker compose up -d)
# DATABASE_URL=postgresql://damhwa:damhwa@localhost:5432/damhwa

# OpenAI 키: 음성 대화 + 홈 화면 'AI 한 줄 요약'이 켜짐 (없어도 서버·사이버 경로당은 동작, 요약은 규칙 기반)
# 이 파일에만 넣고 다른 곳에 올리지 마세요.
OPENAI_API_KEY=
# (선택) 한 줄 요약에 쓸 모델 (기본 gpt-4o-mini, 틀려도 규칙 요약으로 대체)
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

# 사이버 경로당: 서로 다른 몇 명이 신고하면 메시지를 자동 숨길지 (기본 3)
CHAT_HIDE_THRESHOLD=3
# 운영자 신고 관리 API 키 (8자 이상, 비우면 운영자 API 꺼짐)
CHAT_ADMIN_KEY=
# (선택) 보낸 사진 저장 폴더 (기본 backend/uploads)
# CHAT_UPLOAD_DIR=
