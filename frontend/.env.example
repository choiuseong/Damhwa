# ── 담화 프론트엔드 환경 설정 ──
# 이 파일을 복사해 .env 로 만든 뒤 값을 바꾸고, Expo 를 다시 시작하세요.
# 주의: EXPO_PUBLIC_ 로 시작하는 값은 앱 안에 그대로 들어가 누구나 볼 수 있어요.
#       OpenAI API 키 같은 비밀값은 절대 여기에 넣지 말고 backend/.env 에만 넣으세요.

# 화면 미리보기 모드: true = 서버·마이크·위치·알림 없이 가짜 데이터로 화면만 보기 (웹 브라우저 시연용)
#                    false 또는 비워 두기 = 원래 동작
EXPO_PUBLIC_PREVIEW_MODE=false

# 백엔드 주소. 비워 두면 서버 없는 데모 모드. 예) http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=
